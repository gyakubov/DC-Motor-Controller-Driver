# R
#
DEF R R 0 40 N Y 1 F N
F0 "R" 0 100 50 H V C CNN
F1 "R" 0 -100 50 H V C CNN
F2 "" 0 0 50 H I C CNN
F3 "~" 0 0 50 H I C CNN
DRAW
S -40 -100 40 100 0 1 10 N
X ~ 1 0 150 50 D 50 50 1 1 P
X ~ 2 0 -150 50 U 50 50 1 1 P
ENDDRAW
ENDDEF
